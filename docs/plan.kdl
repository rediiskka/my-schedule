// План работы: очередь пунктов, состояние каждого, признак готовности.
// Лежит в docs/ репозитория: на виду, едет вместе с кодом, читается любым агентом
// с доступом к репозиторию — без внешней памяти и без дрейфа двух версий.
// Смотреть: node ~/.claude/skills/plan-and-iterate/plan.mjs where
//
// Копия во внешней памяти остаётся для того, кто до репозитория не дотянулся.
// updated= на корневом узле — чья версия свежее при сверке.

plan "my-schedule - личное расписание поверх расписания группы" updated="2026-09-02 21:06" {

    step skilly-para "Скиллы контекста и плана работают в паре" done=true restored=true {
        why "Веб-агент видит только внешнюю память, локальная сессия - только диск. Без общего порядка синхронизации план и контекст расходятся молча"
        how "load-context читает план сразу после контекста; save-context пишет файл, потом копию; в plan-and-iterate - метка updated= для сверки и команда touch; из скилла убраны следы чужого проекта"
        done_when "оба скилла ссылаются на план, порядок синхронизации описан, скиллы не привязаны к конкретному проекту"

        check "load-context читает план шагом 3.5" got="читает файл, при его отсутствии - копию из памяти, сверка по updated" ok=true
        check "save-context пишет план шагом 3.5" got="touch, затем копия в память, файл первичен" ok=true
        check "в plan-and-iterate нет следов чужого проекта" got="упоминания шаблона, сайтов и sync-journal убраны" ok=true
        check "команда touch работает" got="ставит updated= на корневом узле; сначала не работала - в регулярку попал символ backspace вместо \b" ok=true
    }

    step kron-otmetki "Крон отметок прогресса" done=true restored=true {
        why "Скилл требует страховку на случай, когда события долго не наступают: работа встала, а сказать об этом некому"
        how "Раз в полчаса на некруглой минуте: факт по git, маркер, сверка с фактом, touch и копия в память"
        done_when "задача заведена и живёт до конца сессии"

        check "крон создан" got="17,47 каждый час, сессионный, авто-истекает через 7 дней" ok=true
    }

    step karta-agenta "Документы для агента в репозитории" done=true restored=true {
        why "Агент из веба не знает ни где контекст, ни где план, ни где креды. Правила кода тоже жили только в соседнем репозитории"
        how "AGENTS.md - карта внешней памяти и порядок чтения; CLAUDE.md перенесён из raspisanie-3bi1 и адаптирован; в глобальных правилах анонимность сужена до коммитов и текстов"
        done_when "в репозитории есть карта памяти и правила кода, паролей в них нет"

        check "в AGENTS.md нет паролей и адреса сервера памяти" got="только адреса заметок и порядок чтения" ok=true
        check "CLAUDE.md описывает этот проект" got="источник расписания, разделение сайт-читает/утилита-пишет, граница шифрования" ok=true
    }

    step utilita-pod-pary "Утилита под записи формата пары и зашифрованный индекс" done=true restored=true {
        why "Личное должно быть тем же data.json, только зашифрованным, а сайту нужен отрезок без расшифровки всего файла"
        how "tools/vault.py начисто: запись повторяет пару из data.json, my-data.json - фрагменты, index.json - зашифрованный индекс с датами и позициями"
        done_when "запись заводится и правится командой, индекс читается первым, чужой пароль не открывает"

        check "add, edit, rm, list работают" got="проверено на трёх записях, вывод с временем пары и аудиторией" ok=true
        check "отрезок по датам" got="сначала терял границу дня - нижняя считалась с максимальной парой, исправлено" ok=true
        check "фрагменты одной длины" got="16 фрагментов по 720 символов независимо от числа записей" ok=true
        check "индекс зашифрован" got="в index.json только v, salt и шифроблок" ok=true
    }

    step vosstanovlennye "Восстановленный пункт отличается от измеренного" done=true since="2026-09-02 19:11" at="2026-09-02 19:12" {
        why "Скилл запрещает метки задним числом, а утилита требует at у закрытого. Работа, шедшая мимо плана, не вписывается ни туда, ни сюда - и либо теряется, либо получает выдуманное время"
        how "Признак restored=true: пункт восстановлен по факту, время не измерялось. Инвариант про at на такие не срабатывает, но сам признак виден в файле"
        done_when "восстановленный пункт проходит check и при этом отличим от измеренного"

        check "check не ругается на восстановленные" got="четыре восстановленных пункта с restored=true проходят, инварианты держатся" ok=true
        check "в скилле записано, чем restored отличается от done с меткой" got="строка в таблице атрибутов плюс абзац перед разделом о метках времени" ok=true
    }

    step plan-v-repo "План едет в репозиторий" done=true since="2026-09-02 19:13" at="2026-09-02 19:14" {
        why "Агент с доступом к репозиторию прочтёт план без внешней памяти - один канал вместо двух, и нечему разъезжаться. Секретного в плане нет"
        how "Убрать .claude/ из .gitignore, оставив там .env; путь для утилиты не меняется. В AGENTS.md указать, что план лежит в репозитории, а копия в памяти - для агента без доступа к нему"
        done_when "plan.kdl коммитится вместе с кодом, .env по-прежнему не коммитится"

        check "plan.kdl попадает в git, .env - нет" got="docs/plan.kdl виден в git status, .env отсекается .gitignore" ok=true
        check "AGENTS.md называет репозиторий первым источником плана" got="память названа копией для того, у кого нет репозитория" ok=true
    }

    step lichnye-pary "Личный файл - записи формата пары, а не задачи" done=true since="2026-09-02 19:14" at="2026-09-02 19:31" {
        note "Сайт пока на старой схеме: index.html читает tasks.json, которого уже нет — значит показывает расписание группы без личных записей, не падая. Перевод на index.json + my-data.json начинался и был откачен, чтобы не оставлять файл в промежуточном виде. Заново: заменить блок шифрования на чтение индекса (ключ из соли index.json, decryptFragment, decryptIndex, openMine), слой TASKS_* — на MY_INDEX/MY_ITEMS с выборкой по отрезку, карточки — на формат пары (subject/type/teacher/room, PAIR_TIME по номеру пары), и рубильник st.uni первой проверкой в match(). Правки делать по уникальным якорям: замена по индексам в этом файле уже трижды продублировала блок."
        why "Вика просила такой же data.json, только зашифрованный: личные пункты должны вставать в сетку рядом с парами, а не жить отдельным слоем с галочкой"
        how "Перевести index.html на новый слой: читать index.json и my-data.json вместо tasks.json, показывать записи формата пары рядом с парами группы"
        done_when "личная запись видна в списке, неделе и месяце вместе с парами, вставка новой меняет одну строку файла"

        check "берётся только отрезок, а не весь файл" got="неделя - 1 расшифрованный фрагмент из 16, месяц - 3 из 16" ok=true
        check "нет файлов - сайт не падает" got="убрал index.json и my-data.json: 10 пар, вёрстка и легенда целы, заглушки нет" ok=true
        check "рубильник гасит пары группы" got="выключено - 0 пар, свои записи на месте" ok=true

        check "запись встаёт в сетку рядом с парами" got="список: карточка Тренировки рядом с парами; месяц: три чипа. Легенда и фильтры целы" ok=true
        check "фрагменты отсортированы по дате" got="индекс идёт по возрастанию, обход прерывается на первой дате за окном" ok=true
        check "вставка в середину меняет одну строку, соседние байт в байт те же" got="проверено на прошлой схеме: из 16 строк менялась одна; утилита сохраняет прежние фрагменты как есть" ok=true
        check "старый tasks.json больше не нужен и убран" got="удалён, ссылок в коде не осталось" ok=true
    }
    step karta-kak-para "Личная запись выглядит как пара и помечена как своя" done=true since="2026-09-02 19:33" at="2026-09-02 19:48" {
        why "Правило проекта: карточки устроены одинаково. Сейчас у пары слева колонка «N пара / время» и плашка аудитории справа, а у моей записи время внутри и аудитория текстом - глазу видно чужеродное. И наоборот, отличить свою запись от пары нечем: у пар в сетке есть кружок подгруппы, у моих ничего"
        how "Собирать запись той же структурой .pair + .pair-time + .stack, тело через linfo/roomSide как у занятий. Свой маркер - кружок рядом с названием и в чипах недели и месяца, тем же классом .msg"
        done_when "запись в списке неотличима по устройству от пары, но помечена как своя и в списке, и в сетке"

        check "при скрытых парах не остаётся данных вуза" got="день самостоятельной работы и пояснения про чётность недель уходят вместе с парами" ok=true
        check "интерфейс не путает" got="переключатель Пары поднят к Виду, поиск опущен к периоду, кнопка «Месяц вперёд» убрана - месяц и так период по умолчанию" ok=true

        check "в списке у записи слева время, справа аудитория" got="колонка та же, что у пар; номер пары убран - планы в общем случае не про универ, а «3 пара» в день самостоятельной работы вводило в заблуждение" ok=true
        check "запись без номера пары показывает своё время и не ломает колонку" got="19:00 у тренировки, колонка ровная" ok=true
        check "маркер своей записи виден в списке, неделе и месяце" got="розовое сердце из спрайта: в карточке пилюлей «моё», в сетке рядом со временем. Плюс розовая заливка и полоса по нижнему краю ячейки" ok=true
        check "смоки: список, месяц, обе темы" got="карточка и заливка читаются в обеих темах; узкие колонки четверга и воскресенья расширяются, если в дне есть своя запись" ok=true
    }

    step zapomnit-vhod "Не спрашивать пароль на каждом открытии" done=true since="2026-09-02 19:48" at="2026-09-02 19:50" {
        why "Ключ живёт в sessionStorage и умирает с вкладкой: с телефона пароль вводится каждый раз заново. Вика просила вводить один раз на устройстве"
        how "Перенести ключ в localStorage. Осознанный размен: ключ ложится на диск, и кто дошёл до её разблокированного браузера, откроет расписание - но он и пароль оттуда достанет не сложнее"
        done_when "после закрытия браузера сайт открывается без пароля, а очистка данных сайта возвращает гейт"

        check "поля периода показывают открытый диапазон" got="02.09.2026 - 02.10.2026 подставляются, пока свой период не задан" ok=true

        check "закрыл браузер, открыл - записи на месте, пароль не спрашивают" got="ключ в localStorage: после очистки sessionStorage и перезагрузки гейт не появился, три записи на месте" ok=true
        check "очистка данных сайта возвращает экран пароля" got="localStorage.clear() - гейт вернулся" ok=true
        check "чужой пароль по-прежнему не открывает файлы" got="проверялось на этой же схеме: чужой ключ даёт OperationError на индексе" ok=true
    }


    step selektor-za-skrollom "Селектор недели следует за прокруткой" done=true since="2026-09-02 19:52" at="2026-09-02 19:58" {
        why "Период показа и навигация по нему склеены: выбор недели схлопывает заданный месяц и стирает поля периода. А ищут чаще сразу по месяцу, и каждый раз вводить его заново - работа против пользователя. Заодно селектор стоит на одной неделе, пока список идёт через несколько"
        how "Селектор в списке отсекает начало: выбранная неделя становится началом периода, конец остаётся прежним. Список сразу открывается с неё - прокручивать через месяц не нужно, период не схлопывается, поля не стираются, а обновляются. В видах неделя и месяц селектор остаётся выбором данных - там это единственная навигация"
        done_when "выбор недели сдвигает начало периода, конец и поля остаются согласованными"

        check "выбор недели в списке двигает начало периода, конец на месте" got="период 02.09-02.10, выбрал 4-ю неделю - стало 28.09-04.10" ok=true
        check "поля периода показывают новый диапазон, а не пустоту" got="сначала не обновлялись - поля заполнялись один раз при старте; вынес syncPeriodInputs в render" ok=true
        check "в видах неделя и месяц селектор по-прежнему выбирает данные" got="там ветка прежняя, scope=week" ok=true
        check "короткий период растягивается до недели" got="был 01.09-03.09, выбрал первую неделю - стал 07.09-13.09" ok=true
    }
    step vid-uvazhaet-period "Виды неделя и месяц показывают весь период" done=true since="2026-09-02 19:58" at="2026-09-02 20:03" {
        why "Период отвечает за то, что показываем, вид - за то, как. Сейчас список период уважает, а неделя и месяц рисуют ровно одну свою и период игнорируют: задал месяц, переключился на неделю - показана одна, остальное пропало"
        how "Обернуть renderWeek и renderMonth в обход тех недель и месяцев, что попадают в период: сетки идут одна под другой, как секции дней в списке. Селектор остаётся навигацией по ним"
        done_when "период в месяц даёт в виде недели четыре сетки подряд, в виде месяца - один-два месяца, и это совпадает со списком"

        check "подпись сверху совпадает с периодом" got="во всех видах 02.09.2026 - 02.10.2026, а не одна неделя" ok=true

        check "период месяц - вид неделя показывает все недели периода" got="пять сеток подряд с заголовками недель" ok=true
        check "период неделя - показывается одна, как раньше" got="scope=week даёт одну сетку и подпись «Неделя N»" ok=true
        check "вид месяц показывает месяцы периода" got="сентябрь и октябрь, два грида" ok=true
        check "дни вне периода видно, но приглушены" got="сетка рисует целую неделю и целый месяц - так они устроены; 21 ячейка недели и 30 дней месяца ушли в dim" ok=true
    }


    step uni-iz-repo "Универское расписание тянется из своего репозитория живьём" done=true since="2026-09-02 20:06" at="2026-09-02 20:07" {
        why "Расписание группы обновляется в raspisanie-3bi1, и копия здесь устаревает молча. Сайт должен брать свежее оттуда, а не хранить снимок"
        how "fetch raw.githubusercontent.com/rediiskka/raspisanie-3bi1/refs/heads/master/data.json (CORS открыт, проверено). Локальный data.json остаётся запасным на случай, если raw недоступен"
        done_when "сайт показывает пары из чужого репозитория, а при недоступности raw не падает, а берёт локальную копию"

        check "пары приходят с raw и совпадают с исходником" got="запрос уходит на raw.githubusercontent.com, локальная копия не трогается; 18 недель, 63 занятия в периоде" ok=true
        check "raw недоступен - сайт работает на локальной копии" got="подменил fetch на отказ - расписание пришло из локального data.json, те же 18 недель" ok=true
    }
    step setka-po-vremeni "Недельная сетка строится по времени, а не по парам" done=true since="2026-09-02 20:14" at="2026-09-02 20:19" {
        why "Сетка построена по парам - наследство исходного сайта, который был про пары. Здесь расписание личное, пары один из слоёв и к тому же отключаемый: строки «1 пара», «2 пара» делают их первичными, а свои записи вытесняют в отдельную строку внизу"
        how "Строки - часы, от первого события дня до последнего в периоде. Пары и свои записи ложатся в них одинаково, по своему времени. Номер пары остаётся подписью занятия, а не осью сетки"
        done_when "в сетке нет строк-пар и нижней строки, всё стоит по времени"

        check "пары и свои записи стоят в одних строках по времени" got="строки 08:00-19:00, тренировка в 19:00 рядом с парами, отдельной строки нет" ok=true
        check "рубильник гасит пары, сетка времени остаётся" got="при скрытых парах остаётся одна строка - 19:00 со своей записью" ok=true
        check "диапазон часов подстраивается под события" got="с парами 08:00-19:00, без них только 19:00" ok=true
        check "в месяце и списке порядок записей не изменился" got="месяц и список рисуются прежним кодом, правка только в недельной таблице" ok=true
    }
    step nalozheniya "Наложения видно, а не приходится замечать самому" done=true since="2026-09-02 20:19" at="2026-09-02 20:23" {
        why "Своя запись может попасть на пару, и сейчас это ниоткуда не видно: события одного часа просто стоят в ячейке друг под другом. Расписание, которое молчит про конфликт, хуже бумажки"
        how "У события есть начало и конец: у пары из её времени, у своей записи из времени и длительности. При пересечении своя запись идёт первой и остаётся яркой, пара под ней приглушается: раз человек завёл своё на это время, значит выбор уже сделан. Помечаем рамкой и словом, но ничего не двигаем - пары не подвинуть, а свою запись переносит владелец"
        done_when "запись, попавшая на пару, помечена и в списке, и в сетке; непересекающиеся рядом стоят спокойно"

        check "запись на время пары помечена как наложение" got="08:45+40 против пары 8:30-10:00 - рамка и пилюля «наложение»" ok=true
        check "запись впритык, конец в конец, наложением не считается" got="сравнение строгое: a.start<b.end и b.start<a.end" ok=true
        check "две свои записи внахлёст тоже помечены" got="в списке пересечение своих считается тем же myClash" ok=true
        check "метка видна в списке и в недельной сетке" got="в сетке рамка на чипе, в списке пилюля «наложение» и обводка карточки" ok=true
