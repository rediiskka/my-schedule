// План работы: очередь пунктов, состояние каждого, признак готовности.
// Лежит в docs/ репозитория: на виду, едет вместе с кодом, читается любым агентом
// с доступом к репозиторию — без внешней памяти и без дрейфа двух версий.
// Смотреть: node ~/.claude/skills/plan-and-iterate/plan.mjs where
//
// Копия во внешней памяти остаётся для того, кто до репозитория не дотянулся.
// updated= на корневом узле — чья версия свежее при сверке.
//
// Закрытое отсюда убрано: оно живёт в истории git и в заметке контекста.

plan "my-schedule - личное расписание поверх расписания группы" updated="2026-09-02 22:15" {

    step otrezok-binarno "Сайт берёт отрезок бинарным поиском, не расшифровывая всё" {
        why "Пока записей десятки, окно берётся простым обходом индекса и это мгновенно. На тысячах записей за годы обход станет линейным по всему файлу, а границы отрезка ищутся за log2(n) расшифровок - и без единой открытой даты наружу"
        how "lowerBound по дате: расшифровываем фрагмент в середине, сравниваем дату, сужаем. Найдя левую границу, читаем подряд до правой. Расшифрованное уже кладётся в кэш по индексу фрагмента"
        done_when "показ недели расшифровывает границы плюс сами записи этой недели, а не весь файл"

        check "на файле в тысячу записей неделя стоит log2 расшифровок плюс размер отрезка"
        check "границы отрезка верные: первая и последняя запись диапазона на месте"
        check "кэш не даёт расшифровывать один фрагмент дважды"
        check "битый порядок фрагментов не теряет записи молча"
    }

    step pereimenovat-papku "Переименовать корневую папку в my-schedule" blocked="папку держит рабочая директория сессии - только после её закрытия" {
        why "Папка называется «My shedule», с опечаткой и не как проект. Пути в памяти и в карте агента уже указывают на my-schedule"
        how "После выхода из сессии: Rename-Item с новым именем"
        done_when "папка называется my-schedule, сессия открывается из неё"

        check "папка переименована, git и .env на месте"
    }

    step obratnaya-svyaz "Правки после первой недели" blocked="ждём, как пройдёт неделя с этим расписанием" {
        why "Расписание расставлено предложением, а не решением: время выбрано ассистентом и помечено auto. Пока Вика не прожила с ним неделю, править нечего - иначе это будет угадывание вместо обратной связи"
        how "Спросить по итогам: что сдвинуть, что убрать, что добавить из тех сорока четырёх с меткой разобрать. Отказ от слота становится правилом в скилле раскладки, а не разовой правкой"
        done_when "расписание поправлено по её ответам, а правила в скилле обновлены"

        check "неудобные слоты переставлены или сняты"
        check "то, что не зашло, записано правилом, а не заметкой"
    }
}
